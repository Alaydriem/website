---
import site from '../lib/site.json';
import { BREAKPOINTS, FIRST_BACKGROUND } from '../lib/backgrounds.js';
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Redirect stubs ask not to be indexed while still passing their link on. */
  noindex?: boolean;
  ogType?: string;
  preloadHero?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
  ogType = 'website',
  preloadHero = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
 * One preload per breakpoint, each one carrying the same media query the
 * stylesheet uses to choose that file. A single preload cannot do this: the
 * hero background is full-bleed, so a phone and a desktop want files three
 * times apart in size, and preloading the large one everywhere would cost more
 * than preloading nothing.
 *
 * The 0.02px is the usual guard against a fractional viewport width falling
 * into the gap between max-width and the next min-width.
 *
 * AVIF only, and declared as such. A browser that cannot decode it skips the
 * link and loads the JPEG through the stylesheet at normal priority, which is
 * the right trade for a format that all current browsers support.
 */
const heroPreloads = [
  { size: 'sm', media: `(max-width: ${BREAKPOINTS.sm - 0.02}px)` },
  { size: 'md', media: `(min-width: ${BREAKPOINTS.sm}px) and (max-width: ${BREAKPOINTS.md - 0.02}px)` },
  { size: 'lg', media: `(min-width: ${BREAKPOINTS.md}px)` },
].map(({ size, media }) => ({
  media,
  href: `/assets/images/bg/${FIRST_BACKGROUND}-${size}.avif`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta name="author" content="Alaydriem" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#0F0A1C" />

    {/* The live client reads this rather than holding a build-time constant.
        An empty value turns the feature off and the page makes no request. */}
    <meta name="live-status-url" content={site.liveStatusUrl} />

    {preloadHero && heroPreloads.map(({ href, media }) => (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        href={href}
        media={media}
        fetchpriority="high"
      />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Alaydriem" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicon/site.webmanifest" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
