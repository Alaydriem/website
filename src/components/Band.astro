---
import site from '../lib/site.json';
---

<section class="band" aria-labelledby="band-title">
  <div class="wrap band__inner">
    <div class="band__copy">
      <p class="label band__eyebrow">The project</p>
      <h2 class="band__title" id="band-title">Bedrock Voice Chat</h2>
      <p class="band__text">
        Proximity voice chat for Minecraft Bedrock. Hear the players next to you,
        and lose them as they walk away. Free, open source, and running on
        Windows, macOS, Linux and Android.
      </p>
    </div>
    <a class="btn band__cta" href={site.links.bvc} rel="noopener">
      Get Bedrock Voice Chat
    </a>
  </div>
</section>
