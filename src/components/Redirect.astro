---
/**
 * A canonical redirect stub.
 *
 * GitHub Pages cannot issue a 301 — there is no _redirects file and no rewrite
 * rules — so the equivalent under our control is a canonical link plus an
 * instant meta refresh, which search engines consolidate the same way.
 *
 * `noindex, follow` keeps the stub itself out of the index while still letting
 * the link through to the destination count.
 */
interface Props {
  to: string;
  title: string;
  label: string;
  description?: string;
}

const { to, title, label, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content={description ?? label} />
    <meta name="theme-color" content="#0F0A1C" />

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #0f0a1c;
        color: #fbf8ff;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
        line-height: 1.65;
      }
      a { color: #bb8dfa; }
    </style>
  </head>
  <body>
    {/* The visible fallback. A browser that ignores the refresh, or a reader
        who arrives with it disabled, still gets where they were going. */}
    <main>
      <p>Taking you there&hellip;</p>
      <p><a href={to}>{label}</a></p>
    </main>
  </body>
</html>
