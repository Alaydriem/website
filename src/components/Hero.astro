---
import Nav from './Nav.astro';
import VideoCard from './VideoCard.astro';
import site from '../lib/site.json';
import youtube from '../../data/youtube.json';
import { watchUrl } from '../lib/format.js';

const { channel, videos } = youtube;

// Spec section 12 makes this the only hard failure in the build. A homepage
// whose primary action points at a video that is not in the data would publish
// a broken button, so the build stops instead.
const pinned = videos.find((v) => v.id === site.pinnedVideo);
if (!pinned) {
  throw new Error(
    `src/lib/site.json pins video "${site.pinnedVideo}", which is not present in `
    + 'data/youtube.json. The homepage\'s primary action would be broken, so the build is stopped.',
  );
}

const short = pinned.title.length > 46 ? `${pinned.title.slice(0, 46)}…` : pinned.title;
const number = (n: number) => n.toLocaleString('en-US');
---

<header class="hero" data-hero data-live="false">
  <div class="hero__bg" style="--hero-image: url('/assets/images/bg/header-bg-lg.jpg')"></div>

  <Nav />

  {/*
    The live takeover. Rendered but hidden, and swapped in wholesale when a
    stream is running.

    This deliberately departs from the original "only text and colour change"
    rule. That rule protected the common case, and it still does — offline,
    this block never displays and nothing moves. But applied to the live state
    it produced a hero that looked broken rather than live, which is the one
    moment the page has something urgent to say.

    The iframe ships with no src, so nothing loads until it is set. That keeps
    the DOM stable: going live sets an attribute, it does not insert elements.
  */}
  {/* The alternates are read by the client: the stream runs on both platforms
      at once, so whichever one is embedded, the other gets a link. */}
  <div
    class="wrap hero__live"
    data-live-block
    data-alt-twitch={site.links.twitch}
    data-alt-youtube={site.links.youtubeLive}
    hidden
  >
    <div class="hero__live-copy">
      <p class="hero__badge hero__badge--live">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        Live now
      </p>
      <span class="hero__viewers" data-live-viewers></span>

      <h2 class="hero__live-title" data-live-title>Live on stream</h2>

      <div class="hero__actions">
        <a class="btn btn--live" data-live-cta href="#" rel="noopener">
          Watch the stream
        </a>
        <a class="btn btn--ghost" data-live-alt href="#" rel="noopener">
          Also on YouTube
        </a>
      </div>
    </div>

    <div class="hero__player">
      <iframe
        data-live-player
        title="Live stream"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"></iframe>
      {/* Shown when the platform has no embed we are willing to frame. */}
      <a class="hero__player-fallback" data-live-fallback href="#" rel="noopener">
        Open the stream
      </a>
    </div>
  </div>

  <div class="wrap hero__inner" data-pinned-block>
    <div class="hero__copy">
      {/* The pinned block no longer mutates. Going live swaps this whole
          block out for hero__live rather than rewriting it in place. */}
      <p class="hero__badge">
        START HERE
      </p>

      <h1 class="hero__title">
        Minecraft<br />
        <span class="hi">but better</span>
      </h1>

      <p class="lead hero__lead">
        Farms & Redstone Tutorials, Tools & Utilities, and Amazing Builds for Minecraft Bedrock Edition
      </p>

      {/* Built as one string. Split across lines with expressions between, JSX
          collapses the whitespace and the separators end up jammed against the
          next number. */}
      <p class="hero__stats">
        {`${number(channel.videoCount)} videos · ${number(channel.subscriberCount)} subscribers · ${number(channel.viewCount)} views`}
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={watchUrl(pinned.id)} rel="noopener">
          Watch: {short}
        </a>
        <a class="btn btn--ghost" href="#watch">Browse everything</a>
      </div>
    </div>

    {/* Three newest uploads. Not rendered below 1100px; they are already in the
        Watch panel and a second copy would be noise. */}
    <aside class="hero__rail" aria-label="Latest uploads">
      <p class="hero__rail-title">Latest</p>
      {videos.slice(0, 3).map((video) => <VideoCard video={video} size="compact" />)}
    </aside>
  </div>
</header>
